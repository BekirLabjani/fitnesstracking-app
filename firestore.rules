rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Nutzer dürfen nur ihre eigenen Daten lesen und schreiben
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Öffentliche Profil-Felder (Name, Invite-Code, Avatar, Größe):
    // lesbar für alle eingeloggten Nutzer (nötig für Freundessuche & Freundesliste),
    // schreibbar nur vom Besitzer.
    match /userProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Freundschaftsbeziehungen: Dokument-ID ist deterministisch
    // "<followerId>_<followedId>", damit die trainings-Regel unten sie
    // per exists() prüfen kann.
    match /friends/{friendId} {
      allow read: if request.auth != null && resource.data.followerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.followerId == request.auth.uid
        && friendId == request.auth.uid + '_' + request.resource.data.followedId;
      allow delete: if request.auth != null && resource.data.followerId == request.auth.uid;
    }

    // Eigene Übungen: nur der Besitzer darf sie lesen/ändern/löschen.
    match /customExercises/{exerciseId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Trainingsplan: ein Dokument pro Nutzer (Dokument-ID = userId).
    match /trainingPlans/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Trainings: eigene Einträge voll lesbar/schreibbar; Einträge von Freunden
    // (denen man per /friends folgt) sind nur lesbar, damit Bestleistungen
    // von Freunden angezeigt werden können.
    match /trainings/{trainingId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        exists(/databases/$(database)/documents/friends/$(request.auth.uid + '_' + resource.data.userId))
      );
      allow write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Kalorien-Tagebuch: rein privat, kein Freundes-Lesezugriff (anders als
    // trainings) — Ernährungsdaten sind sensibler als Trainingsgewichte.
    match /calorieLogs/{entryId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Premium-Status: nur über die Firebase Console (Admin-SDK, umgeht
    // Rules) änderbar, niemals über die App. Ein client-beschreibbares
    // Premium-Feld wäre eine Privilegieneskalations-Lücke — siehe ADR-001.
    match /entitlements/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Alles andere ist verboten
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
